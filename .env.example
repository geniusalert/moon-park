# Copy to .env. The local AI service reads this file on each request.
# Never put the key in browser code or upload .env.
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_API_FORMAT=meta

# Older Meta Llama API accounts can instead use:
# META_API_FORMAT=llama
# META_API_BASE_URL=https://api.llama.com/v1
# META_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# LLAMA_API_KEY= (accepted as an alternative key variable)
